{
  "openapi": "3.0.3",
  "info": {
    "title": "Job Seeker Copilot User Profile API",
    "version": "1.0.0",
    "description": "Producer-owned contract for authenticated current-user profile operations."
  },
  "tags": [
    {
      "name": "User Profiles",
      "description": "Authenticated current-user profile operations"
    }
  ],
  "paths": {
    "/api/profiles/me": {
      "get": {
        "tags": [
          "User Profiles"
        ],
        "operationId": "getMyProfile",
        "summary": "Get the authenticated user's profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "404": {
            "description": "Profile not found"
          }
        }
      },
      "put": {
        "tags": [
          "User Profiles"
        ],
        "operationId": "createOrUpdateMyProfile",
        "summary": "Create or replace the authenticated user's profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserProfile"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "400": {
            "description": "Profile validation failed"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "409": {
            "description": "Concurrent profile write conflict; retrying the complete request is safe"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "readOnly": true
          },
          "userId": {
            "type": "string",
            "maxLength": 128,
            "readOnly": true
          },
          "skills": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "aspirations": {
            "$ref": "#/components/schemas/Aspirations"
          },
          "workPreferences": {
            "$ref": "#/components/schemas/WorkPreferences"
          },
          "qualifications": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Qualification"
            }
          },
          "roles": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          }
        }
      },
      "Aspirations": {
        "type": "object",
        "properties": {
          "targetRoles": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "targetWeeklyHours": {
            "$ref": "#/components/schemas/TargetWeeklyHours"
          }
        }
      },
      "TargetWeeklyHours": {
        "type": "string",
        "enum": [
          "FULL_TIME",
          "PART_TIME_16_30",
          "PART_TIME_UNDER_16",
          "FLEXIBLE"
        ]
      },
      "WorkPreferences": {
        "type": "object",
        "properties": {
          "location": {
            "$ref": "#/components/schemas/PostcodeLocation"
          },
          "commuteRange": {
            "type": "integer",
            "minimum": 0,
            "maximum": 500
          }
        }
      },
      "PostcodeLocation": {
        "type": "object",
        "properties": {
          "postcode": {
            "type": "string",
            "maxLength": 16,
            "description": "UK full postcode or outcode; normalized by the service"
          },
          "region": {
            "type": "string",
            "maxLength": 100
          },
          "adminDistrict": {
            "type": "string",
            "maxLength": 100
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "Qualification": {
        "type": "object",
        "required": [
          "qualificationName",
          "issuingBody",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "readOnly": true
          },
          "qualificationName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "issuingBody": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "$ref": "#/components/schemas/QualificationStatus"
          },
          "grade": {
            "type": "string",
            "maxLength": 100
          },
          "dateAchieved": {
            "type": "string",
            "maxLength": 30,
            "description": "YYYY-MM or YYYY-MM-DD"
          },
          "expectedCompletion": {
            "type": "string",
            "maxLength": 30,
            "description": "YYYY-MM or YYYY-MM-DD"
          }
        }
      },
      "QualificationStatus": {
        "type": "string",
        "enum": [
          "IN_PROGRESS",
          "COMPLETED"
        ]
      },
      "Role": {
        "type": "object",
        "required": [
          "jobTitle",
          "employer",
          "status",
          "startDate"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "readOnly": true
          },
          "jobTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "employer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "$ref": "#/components/schemas/RoleStatus"
          },
          "startDate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "description": "YYYY-MM or YYYY-MM-DD"
          },
          "endDate": {
            "type": "string",
            "maxLength": 30,
            "description": "YYYY-MM or YYYY-MM-DD"
          },
          "keyResponsibilities": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "RoleStatus": {
        "type": "string",
        "enum": [
          "CURRENT",
          "PREVIOUS_ROLE"
        ]
      }
    }
  }
}
